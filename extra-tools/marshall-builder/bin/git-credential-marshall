#!/usr/bin/env bash
# Git credential helper for MarshallBuilder (CUP-4838).
#
# Registered once via:
#   git config --global credential.helper /workspace/extra/marshall-builder/bin/git-credential-marshall
# (prepare_workspace does this on every call — idempotent, harmless to repeat)
#
# git invokes this fresh on every HTTPS auth challenge to github.com — no
# caching here, on purpose. Each call mints a brand-new ~1h GitHub App
# installation token from pp-hub and hands it over once; git never learns a
# token that could go stale mid-session. See pp-hub's
# POST /api/marshall/github-token (src/lib/marshall/github-app-token.ts) for
# where the actual signing happens — the private key never reaches here.
#
# No Authorization header is sent to pp-hub here on purpose: this call goes
# through the OneCLI gateway, which injects PPHUB_MARSHALL_API_TOKEN in
# transit for the hub.partnerprogrammer.com host (same mechanism as every
# other credential in this project — nothing sensitive is ever typed by this
# script).
set -euo pipefail

# git's credential helper protocol calls with a verb (get/store/erase) and
# feeds request details on stdin. Only "get" matters — MarshallBuilder never
# persists credentials, so store/erase are silent no-ops.
verb="${1:-}"
[ "$verb" = "get" ] || exit 0

HUB_BASE_URL="${MARSHALL_HUB_BASE_URL:-https://hub.partnerprogrammer.com}"

response=$(curl -sf -X POST "${HUB_BASE_URL%/}/api/marshall/github-token") || {
  echo "git-credential-marshall: failed to reach pp-hub's token-mint endpoint" >&2
  exit 1
}

token=$(printf '%s' "$response" | grep -o '"token":"[^"]*"' | head -1 | sed 's/"token":"//;s/"$//')
if [ -z "$token" ]; then
  echo "git-credential-marshall: pp-hub response had no token field: $response" >&2
  exit 1
fi

printf 'username=x-access-token\npassword=%s\n' "$token"
